# ─────────── ฐานข้อมูล (Railway Postgres) ───────────
# Railway > Postgres service > Variables > DATABASE_URL
# ตอนต่อจากเครื่องตัวเองให้ใช้ค่า public (มี proxy.rlwy.net) ไม่ใช่ค่า internal
DATABASE_URL="postgresql://postgres:password@localhost:5432/alexan?schema=public"

# ─────────── Auth.js ───────────
# สร้างด้วย: npx auth secret   (หรือ openssl rand -base64 32)
AUTH_SECRET=""
# URL จริงของเว็บตอน deploy — ต้องตรงกับ NEXT_PUBLIC_SITE_URL เป๊ะ ๆ ไม่งั้น callback ของ Auth.js พัง
# โดเมนที่จะใช้จริง: https://alexan.studio (จดทะเบียนแล้ว)
AUTH_URL="http://localhost:3000"

# ─────────── ความปลอดภัย ───────────
# โดยปกติไม่ต้องตั้ง — ปล่อยว่างไว้ได้
#
# โดเมนจริงวิ่งผ่าน Cloudflare ก่อนถึง Railway และโค้ดอ่าน IP ผู้ใช้จาก `cf-connecting-ip`
# ซึ่ง Cloudflare เขียนเองและเขียนทับค่าที่ผู้เรียกแนบมาเสมอ จึงไม่ต้องนับชั้น proxy ให้ถูกก่อน
#
# ค่านี้เป็นทางถอยสำหรับกรณีที่ไม่มี `cf-connecting-ip` (เช่น ถอด Cloudflare ออกเหลือ Railway ล้วน ๆ)
# ตอนนั้น 1 คือค่าที่ถูกอยู่แล้ว จะได้ไม่ต้องกลับมาแก้อะไรตาม
TRUSTED_PROXY_HOPS="1"

# ─────────── Cloudflare R2 (เก็บรูป/ไฟล์) ───────────
# Cloudflare Dashboard > R2 > Manage API Tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="alexan-media"
# โดเมนสาธารณะของ bucket เช่น https://media.alexan.studio
R2_PUBLIC_URL=""

# ─────────── Resend (อีเมลแจ้งเตือน lead / ส่งใบเสนอราคา) ───────────
RESEND_API_KEY=""
# ต้องเป็นโดเมนที่ verify แล้วใน Resend
MAIL_FROM="Alexan Production <no-reply@alexan.studio>"
# ปลายทางที่จะรับแจ้งเตือนคำขอใหม่ และเป็นที่อยู่ตอบกลับของใบเสนอราคาที่ส่งให้ลูกค้า
MAIL_TO="hello@alexan.studio"

# ─────────── สาธารณะ (ฝังเข้าไปใน bundle ตอน build) ───────────
# โดเมนจริงคือ https://alexan.studio — ตั้งค่านี้เมื่อ deploy production
#
# ค่านี้เป็นที่มาของ canonical, hreflang, sitemap.xml, robots.txt, JSON-LD และรูปพรีวิวตอนแชร์
# ถ้าตั้งผิดหรือลืมตั้ง Google จะเก็บ index ด้วย URL ที่ผิดทั้งเว็บ
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# ว่างไว้ = ไม่โหลดสคริปต์ Google Analytics เลย
NEXT_PUBLIC_GA_ID=""
# รหัสยืนยันความเป็นเจ้าของเว็บใน Google Search Console (ใส่เฉพาะค่า content ไม่ต้องใส่แท็กทั้งอัน)
# ต้องยืนยันก่อนถึงจะเห็นว่าคนค้นด้วยคำไหนแล้วเจอเรา — ที่เหลือคือการเดา
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ─────────── ผู้ดูแลคนแรก (ใช้ตอน npm run db:seed เท่านั้น) ───────────
SEED_ADMIN_EMAIL="admin@alexan.studio"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Alexan Admin"
